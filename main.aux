\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}FunCat Benchmarks: Competitive, but Below the State of the Art}{11}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces AUPRC on the FunCat datasets, the standard metric in this literature~\cite  {www2022ontology}. Our results (global MLP+R, CPU) are on par with the neural baselines (HMCN-F, C-HMCNN) but below the ontology-learning state of the art. \underline  {Underlined}: better than HMCN-F. \textbf  {Bold}: best.}}{11}{table.caption.6}\protected@file@percent }
\newlabel{tab:funcat}{{4}{11}{AUPRC on the FunCat datasets, the standard metric in this literature~\cite {www2022ontology}. Our results (global MLP+R, CPU) are on par with the neural baselines (HMCN-F, C-HMCNN) but below the ontology-learning state of the art. \underline {Underlined}: better than HMCN-F. \textbf {Bold}: best}{table.caption.6}{}}
\citation{chmcnn}
\citation{chmcnn}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Critical difference diagram (Friedman + Nemenyi, $\alpha =0.05$) over 8 FunCat datasets. Methods closer than CD=2.16 are \emph  {not} significantly different. Our GBDT is statistically tied with HMCN-F.}}{12}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cd}{{3}{12}{Critical difference diagram (Friedman + Nemenyi, $\alpha =0.05$) over 8 FunCat datasets. Methods closer than CD=2.16 are \emph {not} significantly different. Our GBDT is statistically tied with HMCN-F}{figure.caption.7}{}}
