\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sparse R-matrix on the 9 Gene Ontology datasets. AUPRC improves on every dataset (+0.0055 on average).}}{16}{figure.caption.14}\protected@file@percent }
\newlabel{fig:go}{{5}{16}{Sparse R-matrix on the 9 Gene Ontology datasets. AUPRC improves on every dataset (+0.0055 on average)}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces F1 by hierarchy level on 4 representative datasets. On the text hierarchies, F1 falls moderately with depth (by a factor of 1.3--1.6 from the top to the deepest populated level); on FunCat and GO it falls by an order of magnitude. The GO curve is not monotonic, and its sparsest levels are essentially unlearnable.}}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:perlevel}{{6}{16}{F1 by hierarchy level on 4 representative datasets. On the text hierarchies, F1 falls moderately with depth (by a factor of 1.3--1.6 from the top to the deepest populated level); on FunCat and GO it falls by an order of magnitude. The GO curve is not monotonic, and its sparsest levels are essentially unlearnable}{figure.caption.15}{}}
