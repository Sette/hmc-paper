\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Sparse R-Matrix Validation on Gene Ontology}{14}{subsection.5.7}\protected@file@percent }
\newlabel{sec:go_results}{{5.7}{14}{Sparse R-Matrix Validation on Gene Ontology}{subsection.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Sparse R-Matrix on Gene Ontology datasets (9 datasets, 3,128--4,134 classes). The dense baseline is infeasible at this scale, whereas the sparse formulation remains tractable and improves AUPRC on all datasets.}}{14}{table.caption.13}\protected@file@percent }
\newlabel{tab:sparse}{{8}{14}{Sparse R-Matrix on Gene Ontology datasets (9 datasets, 3,128--4,134 classes). The dense baseline is infeasible at this scale, whereas the sparse formulation remains tractable and improves AUPRC on all datasets}{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces AUPRC on Gene Ontology datasets. Our method uses MLP with sparse R-matrix reconciliation at inference (no ontology learning, no GCN). While below the Surj (WWW'22) SOTA, ours is to our knowledge the first \emph  {sparse} formulation that makes R-matrix-constrained inference feasible at this scale (dense R would OOM).}}{15}{table.caption.14}\protected@file@percent }
\newlabel{tab:go_sota}{{9}{15}{AUPRC on Gene Ontology datasets. Our method uses MLP with sparse R-matrix reconciliation at inference (no ontology learning, no GCN). While below the Surj (WWW'22) SOTA, ours is to our knowledge the first \emph {sparse} formulation that makes R-matrix-constrained inference feasible at this scale (dense R would OOM)}{table.caption.14}{}}
