\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces F1 by hierarchy depth level across 4 representative datasets. F1 falls moderately with depth on the text hierarchies (1.3--1.6$\times $ from the root to the deepest populated level) and by an order of magnitude on the FunCat and GO hierarchies; the GO panel is not monotonic, and its sparsest levels are effectively unlearnable.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:perlevel}{{7}{16}{F1 by hierarchy depth level across 4 representative datasets. F1 falls moderately with depth on the text hierarchies (1.3--1.6$\times $ from the root to the deepest populated level) and by an order of magnitude on the FunCat and GO hierarchies; the GO panel is not monotonic, and its sparsest levels are effectively unlearnable}{figure.caption.16}{}}
