\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces R-matrix ablation: Micro-F1 with and without the constraint. $\Delta $ = R on $-$ R off; a positive $\Delta $ means R helps.}}{17}{table.caption.16}\protected@file@percent }
