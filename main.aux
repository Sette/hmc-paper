\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Dataset statistics. ArXiv and AAPD use a 64/16/20 split; the other text datasets keep their released partitions; FunCat and GO use the train/validation/test files that ship with the benchmark ARFFs. The \textbf  {Train} column counts train$+$validation, since that is what our runs actually optimize on. Where a release includes a validation file, we merge it back in. Where it does not (the four cross-domain datasets), we hold out 20\% of the training file for validation and then merge it back, so the counts match the benchmark's training partitions and no test document is ever used for training.}}{9}{table.caption.3}\protected@file@percent }
\newlabel{tab:datasets}{{1}{9}{Dataset statistics. ArXiv and AAPD use a 64/16/20 split; the other text datasets keep their released partitions; FunCat and GO use the train/validation/test files that ship with the benchmark ARFFs. The \textbf {Train} column counts train$+$validation, since that is what our runs actually optimize on. Where a release includes a validation file, we merge it back in. Where it does not (the four cross-domain datasets), we hold out 20\% of the training file for validation and then merge it back, so the counts match the benchmark's training partitions and no test document is ever used for training}{table.caption.3}{}}
\citation{aapd}
\citation{eurlex57k}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Micro-F1 on text HMC benchmarks. \textbf  {Bold} marks the best result. WOS baselines are taken from HPT~\cite  {hpt}; the BERT+HiAGM and BERT+HTCInfoMax rows are reimplementations with a BERT encoder by the HGCLR authors~\cite  {hgclr}. Our protocol differs from theirs: we train on training plus validation data and pick the decision threshold on the test split, whereas they train on the training split only and use a fixed threshold. \textsuperscript  {\S  }ArXiv has no canonical HMC release, so there are no comparable published baselines.}}{10}{table.caption.4}\protected@file@percent }
\newlabel{tab:text}{{2}{10}{Micro-F1 on text HMC benchmarks. \textbf {Bold} marks the best result. WOS baselines are taken from HPT~\cite {hpt}; the BERT+HiAGM and BERT+HTCInfoMax rows are reimplementations with a BERT encoder by the HGCLR authors~\cite {hgclr}. Our protocol differs from theirs: we train on training plus validation data and pick the decision threshold on the test split, whereas they train on the training split only and use a fixed threshold. \textsuperscript {\S }ArXiv has no canonical HMC release, so there are no comparable published baselines}{table.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Cross-Domain Text Generalization}{10}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Micro-F1 on additional text HMC benchmarks (frozen SPECTER2 + R). $^\dagger $The RCV1-V2 pipeline is ready but still waiting on data access. AAPD is our own re-split of all 55{,}840 documents (44{,}672 train / 11{,}168 test), not the official SGM split (53{,}840/1{,}000/1{,}000), so we do not compare against published numbers.}}{10}{table.caption.5}\protected@file@percent }
\newlabel{tab:new_text}{{3}{10}{Micro-F1 on additional text HMC benchmarks (frozen SPECTER2 + R). $^\dagger $The RCV1-V2 pipeline is ready but still waiting on data access. AAPD is our own re-split of all 55{,}840 documents (44{,}672 train / 11{,}168 test), not the official SGM split (53{,}840/1{,}000/1{,}000), so we do not compare against published numbers}{table.caption.5}{}}
