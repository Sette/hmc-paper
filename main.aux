\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}FunCat Benchmarks: Competitive but Below SOTA}{11}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces AUPRC on FunCat datasets. Standard metric per literature convention~\cite  {www2022ontology}. Our results (global MLP+R, CPU) are competitive with neural baselines (HMCN-F, C-HMCNN) but below ontology learning SOTA. \underline  {Underlined}: beats HMCN-F. \textbf  {Bold}: best.}}{12}{table.caption.7}\protected@file@percent }
\newlabel{tab:funcat}{{4}{12}{AUPRC on FunCat datasets. Standard metric per literature convention~\cite {www2022ontology}. Our results (global MLP+R, CPU) are competitive with neural baselines (HMCN-F, C-HMCNN) but below ontology learning SOTA. \underline {Underlined}: beats HMCN-F. \textbf {Bold}: best}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Critical Difference diagram (Friedman + Nemenyi, $\alpha =0.05$) on 8 FunCat datasets. Methods within CD=2.16 of each other are NOT significantly different. Our GBDT is statistically tied with HMCN-F.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cd}{{4}{12}{Critical Difference diagram (Friedman + Nemenyi, $\alpha =0.05$) on 8 FunCat datasets. Methods within CD=2.16 of each other are NOT significantly different. Our GBDT is statistically tied with HMCN-F}{figure.caption.8}{}}
