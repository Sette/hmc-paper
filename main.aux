\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Global (MLP+R) on datasets from other domains: email (Enron), microscopy (Diatoms), and medical imaging (ImCLEF). All use the pre-extracted features from the ARFF files. The files we use ship training and validation data together, so we hold out 20\% of the training file for validation and merge it back for training; the test split is never seen during optimization. The C-HMCNN column gives the AUPRC reported in~\cite  {chmcnn} (average of 10 runs); note that it lists 1{,}549 training$+$validation samples for Diatoms, whereas our file has 2{,}065. Time is wall-clock per run on CPU (50 epochs, batch 128).}}{12}{table.caption.8}\protected@file@percent }
\newlabel{tab:others}{{5}{12}{Global (MLP+R) on datasets from other domains: email (Enron), microscopy (Diatoms), and medical imaging (ImCLEF). All use the pre-extracted features from the ARFF files. The files we use ship training and validation data together, so we hold out 20\% of the training file for validation and merge it back for training; the test split is never seen during optimization. The C-HMCNN column gives the AUPRC reported in~\cite {chmcnn} (average of 10 runs); note that it lists 1{,}549 training$+$validation samples for Diatoms, whereas our file has 2{,}065. Time is wall-clock per run on CPU (50 epochs, batch 128)}{table.caption.8}{}}
