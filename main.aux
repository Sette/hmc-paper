\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Sparse R-Matrix on Gene Ontology}{14}{subsection.5.7}\protected@file@percent }
\newlabel{sec:go_results}{{5.7}{14}{Sparse R-Matrix on Gene Ontology}{subsection.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Sparse R-matrix on the Gene Ontology datasets (9 datasets, 3,128--4,134 classes). At our batch size of 64 the dense baseline runs out of memory; the sparse formulation does not, and it improves AUPRC on every dataset.}}{14}{table.caption.12}\protected@file@percent }
\newlabel{tab:sparse}{{8}{14}{Sparse R-matrix on the Gene Ontology datasets (9 datasets, 3,128--4,134 classes). At our batch size of 64 the dense baseline runs out of memory; the sparse formulation does not, and it improves AUPRC on every dataset}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces AUPRC on the Gene Ontology datasets. Our method is an MLP with sparse R-matrix reconciliation at inference (no ontology learning, no GCN). It stays below Surj (WWW'22), but to our knowledge it is the first \emph  {sparse} formulation of the R-matrix constraint, which lets it run at batch sizes where the dense version runs out of memory.}}{15}{table.caption.13}\protected@file@percent }
\newlabel{tab:go_sota}{{9}{15}{AUPRC on the Gene Ontology datasets. Our method is an MLP with sparse R-matrix reconciliation at inference (no ontology learning, no GCN). It stays below Surj (WWW'22), but to our knowledge it is the first \emph {sparse} formulation of the R-matrix constraint, which lets it run at batch sizes where the dense version runs out of memory}{table.caption.13}{}}
