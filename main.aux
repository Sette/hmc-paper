\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sparse R-Matrix on 9 Gene Ontology datasets. AUPRC improves on all datasets (avg +0.0055).}}{16}{figure.caption.15}\protected@file@percent }
